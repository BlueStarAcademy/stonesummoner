# Copy to .env and adjust for your local Postgres.
# DATABASE_URL unset → in-memory store (ephemeral).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/stonesummoner
PGSSL=0
PORT=8080

# Comma-separated extra browser/WebView origins allowed to call /api with cookies.
# Capacitor defaults (capacitor://localhost, https://localhost, …) are always included.
# CORS_ORIGINS=https://your-custom-origin.example

# Client-only (Vite). Absolute API origin for Capacitor / APK builds (no trailing slash).
# Leave unset for same-origin PWA on Railway.
# VITE_API_BASE=https://your-app.up.railway.app

# Audio generation (apps/web/scripts/gen-audio.mjs). Never commit real keys.
# Free-plan workflow: add a key when you have credits, then generate ONE track:
#   npm run audio:status
#   npm run audio:next
# STABILITY_API_KEY=
# ELEVENLABS_API_KEY=
