{
  "name": "stonesummoner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server.mjs",
    "prebuild": "node ../../scripts/check-skill-art.mjs && node ../../scripts/check-skill-art-manifest.mjs && node ../../scripts/check-battle-fx-art.mjs",
    "build": "npm run check:encoding && vite build",
    "test": "tsx --test src/ui/islandPreload.test.ts",
    "preview": "vite preview",
    "start": "node server.mjs",
    "i18n:gen": "node scripts/gen-i18n-packs.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "smoke:onboarding": "node --experimental-strip-types scripts/smoke-onboarding.mjs",
    "spine:fire_fang": "node scripts/build-fire-fang-spine.mjs",
    "spine:fire_fang:verify": "node scripts/_verify-fire-fang-spine.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:sync": "npm run build && npx cap sync android",
    "audio:gen": "node scripts/gen-audio.mjs",
    "audio:next": "node scripts/gen-audio.mjs --next",
    "audio:status": "node scripts/gen-audio.mjs --status",
    "audio:encode": "node scripts/gen-audio.mjs --synth --all"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@esotericsoftware/spine-pixi-v8": "~4.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "pixi.js": "^8.19.0",
    "stonesummoner-board": "*",
    "stonesummoner-combat": "*",
    "stonesummoner-data": "*",
    "stonesummoner-home": "*",
    "stonesummoner-loop": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
