{
  "name": "stonesummoner",
  "private": true,
  "workspaces": [
    "packages/board",
    "packages/combat",
    "packages/home",
    "packages/data",
    "packages/loop",
    "apps/web",
    "apps/cli"
  ],
  "scripts": {
    "dev": "npm run dev -w stonesummoner-web",
    "api": "npm run api -w stonesummoner-web",
    "build": "npm run build -w stonesummoner-web",
    "start": "npm run start -w stonesummoner-web",
    "cli": "npm run start -w stonesummoner-cli",
    "cli:demo": "npm run demo -w stonesummoner-cli",
    "check:encoding": "node scripts/check-hangul.mjs",
    "pretest": "npm run check:encoding",
    "test": "npm test -w stonesummoner-board && npm test -w stonesummoner-combat && npm test -w stonesummoner-home && npm test -w stonesummoner-data && npm test -w stonesummoner-loop",
    "test:board": "npm test -w stonesummoner-board",
    "test:combat": "npm test -w stonesummoner-combat",
    "test:home": "npm test -w stonesummoner-home",
    "test:data": "npm test -w stonesummoner-data",
    "test:loop": "npm test -w stonesummoner-loop",
    "i18n:gen": "node apps/web/scripts/gen-i18n-packs.mjs",
    "store:graphics": "node scripts/gen-play-store-graphics.mjs",
    "android:sync": "npm run android:sync -w stonesummoner-web",
    "cap:open": "npm run cap:open -w stonesummoner-web",
    "audio:gen": "npm run audio:gen -w stonesummoner-web",
    "audio:next": "npm run audio:next -w stonesummoner-web",
    "audio:status": "npm run audio:status -w stonesummoner-web"
  },
  "engines": {
    "node": ">=20"
  }
}
