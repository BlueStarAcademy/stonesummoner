{
  "name": "stonesummoner",
  "private": true,
  "workspaces": [
    "packages/board",
    "packages/combat",
    "packages/home",
    "packages/data",
    "packages/loop",
    "apps/web",
    "apps/cli"
  ],
  "scripts": {
    "dev": "npm run dev -w stonesummoner-web",
    "api": "npm run api -w stonesummoner-web",
    "build": "npm run build -w stonesummoner-web",
    "start": "npm run start -w stonesummoner-web",
    "cli": "npm run start -w stonesummoner-cli",
    "cli:demo": "npm run demo -w stonesummoner-cli",
    "check:encoding": "node scripts/check-hangul.mjs",
    "pretest": "npm run check:encoding",
    "test": "npm test -w stonesummoner-board && npm test -w stonesummoner-combat && npm test -w stonesummoner-home && npm test -w stonesummoner-data && npm test -w stonesummoner-loop",
    "test:board": "npm test -w stonesummoner-board",
    "test:combat": "npm test -w stonesummoner-combat",
    "test:home": "npm test -w stonesummoner-home",
    "test:data": "npm test -w stonesummoner-data",
    "test:loop": "npm test -w stonesummoner-loop",
    "i18n:gen": "node apps/web/scripts/gen-i18n-packs.mjs",
    "store:graphics": "node scripts/gen-play-store-graphics.mjs",
    "icons:export": "node scripts/export-app-icons.mjs",
    "android:sync": "npm run android:sync -w stonesummoner-web",
    "cap:open": "npm run cap:open -w stonesummoner-web",
    "audio:gen": "npm run audio:gen -w stonesummoner-web",
    "audio:next": "npm run audio:next -w stonesummoner-web",
    "audio:status": "npm run audio:status -w stonesummoner-web",
    "portraits:rebuild": "node scripts/process-all-portraits.mjs",
    "portraits:derivatives": "node scripts/process-all-portraits.mjs --derivatives-only",
    "portraits:qa": "node scripts/process-all-portraits.mjs --qa",
    "monster-art:install": "node scripts/install-battle-stills.mjs",
    "monster-art:sync": "node scripts/sync-painted-monster-art.mjs",
    "monster-art:redematte": "node scripts/redematte-painted-monster.mjs",
    "monster-art:rebuild": "node scripts/install-battle-stills.mjs",
    "monster-art:bake": "node scripts/bake-monster-element-art.mjs",
    "monster-art:check": "node scripts/check-monster-art.mjs --strict",
    "monster-art:portraits": "node scripts/process-all-portraits.mjs --monster-only",
    "monster-art:photoshop": "node scripts/run-photoshop-transparent.mjs",
    "character-art:transparent-all": "node scripts/batch-transparent-character-art.mjs",
    "skill-art:install": "node scripts/install-skill-art.mjs",
    "skill-art:install:all": "node scripts/install-skill-art.mjs && node scripts/install-skill-art.mjs --kind ui && node scripts/install-skill-art.mjs --kind summoner",
    "skill-art:manifest": "tsx scripts/generate-skill-art-manifest.ts",
    "skill-art:manifest:check": "node scripts/check-skill-art-manifest.mjs",
    "skill-art:check": "node scripts/check-skill-art.mjs",
    "skill-art:audit": "node scripts/audit-skill-art.mjs --json docs/art/skill/skill-art-audit.json",
    "skill-art:regen-queue": "node scripts/export-skill-art-regen-queue.mjs",
    "battle-fx:check": "node scripts/check-battle-fx-art.mjs",
    "monster-art:publish-staging": "node scripts/publish-monster-staging.mjs",
    "gear-art:install": "node scripts/install-gear-art.mjs",
    "gear-art:check": "node scripts/check-gear-art.mjs",
    "gear-art:bootstrap": "node scripts/bootstrap-gear-star-art.mjs",
    "gear-art:sync": "node scripts/sync-cursor-gear-pngs.mjs",
    "gear-art:derive": "node scripts/derive-gear-star-art.mjs",
    "gear-art:process": "node scripts/process-paint-icons.mjs ui-gear"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
